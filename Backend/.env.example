# PostgreSQL connection. Use TLS in production. The pool reads PGSSL_DISABLE
# only for local development; production deployments must keep TLS on.
DATABASE_URL=postgresql://user:password@localhost:5432/nedc

# JWT secret. Must be at least 32 random bytes (e.g. `openssl rand -base64 48`).
# The backend refuses to start if this is missing, too short, or contains
# placeholder words (dev/local/example/secret/changeme) in production.
JWT_SECRET=replace-me-with-at-least-32-random-bytes

# JWT lifetime. Tune to match your session expectations. Sessions are also
# bound to the httpOnly cookie's maxAge in auth.controller.ts.
JWT_EXPIRATION=24h

# Set to `false` to disable email-verified-required login. Default behaviour
# (unset) is to REQUIRE verified email before login is allowed.
REQUIRE_EMAIL_VERIFICATION=true

# Razorpay credentials. Webhook secret is configured in the Razorpay dashboard
# and is DIFFERENT from the API key secret. Webhook HMAC is verified against
# the raw request body in payments.service.ts.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Comma-separated list of allowed origins for CORS. Production must list the
# exact domains the frontend is served from.
CORS_ORIGIN=http://localhost:3000

# Listening port.
PORT=3001

# Set to `production` in production. Cookies are flagged `secure` only when
# this is "production"; helmet HSTS is enabled only when this is "production".
NODE_ENV=development

# DEV ONLY: when "true", verification and reset tokens are logged to the
# server console so you can test the flow without a mailer. NEVER enable
# in production.
EMAIL_TOKEN_DEBUG=false

# DEV ONLY: skip TLS for the database. Production deployments should leave
# this unset so the pg pool requires TLS for non-localhost DSNs.
PGSSL_DISABLE=false
